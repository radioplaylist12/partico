                div.innerHTML = `<span style="color:white; font-size:0.75rem;">🎵 ${song.title} - ${song.artist}</span><button style="background:#e63946; border:none; color:white; padding:2px 8px; border-radius:15px; cursor:pointer;">Remover</button>`;
                div.querySelector('button').onclick = () => {
