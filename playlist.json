<div class="swipe-indicator" id="swipeIndicator">👉 Deslize para próxima música</div>
<div class="volume-toast" id="volumeToast">🔊 Volume: 50%</div>
<div class="volume-slider-overlay" id="volumeSliderZone"></div>

<script>
    // ===== CONFIGURAÇÕES (MANTIDAS) =====
    const CONFIG = {
        PIX_KEY: '12988461978',
        WHATSAPP_NUMBER: '5512988461978',
        VOLUME_PLAYER: 0.9,
        INTERVALO_VINHETA_MUSICAS: 10,
        VINHETAS: ['radiopm.mp3', 'Paticom.mp3', 'Paticom.mp3', 'zzvc.mp3'],
        TEMPO_BALAO_LIVE: 5,
        VIDEO_POR_GENERO: {
            SERTANEJO: 'sertanejo181.mp4',
            FORRÓ: 'forro181.mp4',
            'FORRÓ ANTIGO': 'forroant181.mp4',
            BREGA: 'brga181.mp4',
            POP: 'pop181.mp4',
            MPB: 'mpb181.mp4',
            SAMBA: 'samba181.mp4',
            VARIADAS: 'variadas.mp4',
            'MODA TOP': 'modatop181.mp4',
            'AS++': 'pai101.mp4',
            LIVE: 'pai101.mp4',
            DEFAULT: 'pai101.mp4'
        }
    };

    // ===== PLAYLIST EXTERNA (CARREGADA VIA JSON) =====
    let PLAYLIST = [];

    async function carregarPlaylist() {
        try {
            // ⭐ SUBSTITUA ESTA URL PELA URL RAW DO SEU playlist.json ⭐
            const url = 'https://raw.githubusercontent.com/SEU-USUARIO/SEU-REPO/main/playlist.json';
            const resposta = await fetch(url);
            if (!resposta.ok) throw new Error(`HTTP ${resposta.status}`);
            PLAYLIST = await resposta.json();
            console.log(`✅ Playlist carregada: ${PLAYLIST.length} músicas`);
            // Corrige eventuais campos faltantes
            PLAYLIST = PLAYLIST.map(item => {
                if (!item.artist) item.artist = "Desconhecido";
                if (!item.tipo) item.tipo = "normal";
                return item;
            });
            // Inicia o player só depois que a playlist estiver pronta
            if (typeof state !== 'undefined' && state.initCalled) {
                // Se o player já estava tentando iniciar, agora finaliza
                iniciarPlayerAposLoad();
            }
        } catch (erro) {
            console.error('Erro ao carregar playlist.json:', erro);
            PLAYLIST = [];
            // Fallback: tenta usar uma playlist mínima (opcional)
            UIManager.showNotification('❌ Erro ao carregar músicas. Tente recarregar.', 4000);
        }
    }

    // ========== CÓDIGO PRINCIPAL DO PLAYER (IDÊNTICO AO ORIGINAL, APENAS ADAPTADO) ==========
    (function() {
        const state = {
            isPlaying: false,
            isAoVivo: true,
            trocaAutomaticaAtiva: false,
            aoVivoAcabou: false,
            generoAtual: 'SERTANEJO',
            currentIndex: 0,
            filteredPlaylist: [],
            historicoMusicasLive: [],
            tocandoVinheta: false,
            contadorMusicasVinheta: 0,
            skipLock: false,
            isLoadingTrack: false,
            isTvMode: false,
            isBackgroundActive: false,
            shuffleMode: false,
            visualizerAnimationId: null,
            timerInterval: null,
            trackStartTime: 0,
            notificationQueue: [],
            notificationActive: false,
            userPreferences: { likedSongs: [], dislikedSongs: [], songPlays: {}, songComplete: {}, genrePreference: {}, lastPlayed: null },
            stats: { totalPlayed: 0, totalSeconds: 0, genreCount: {}, currentStreak: 0 },
            initCalled: false   // flag para saber se o init já foi executado
        };

        const TimerManager = {
            timers: new Set(),
            setTimeout(fn, delay) { const id = setTimeout(() => { this.timers.delete(id); fn(); }, delay); this.timers.add(id); return id; },
            setInterval(fn, delay) { const id = setInterval(fn, delay); this.timers.add(id); return id; },
            clearTimeout(id) { clearTimeout(id); this.timers.delete(id); },
            clearInterval(id) { clearInterval(id); this.timers.delete(id); },
            clearAll() { this.timers.forEach(id => { clearTimeout(id); clearInterval(id); }); this.timers.clear(); }
        };

        const dom = {
            musicPlayer: document.getElementById('musicPlayer'),
            backgroundAudio: document.getElementById('backgroundAudio'),
            playBtn: document.getElementById('playPauseBtn'),
            prevBtn: document.getElementById('prevBtn'),
            nextBtn: document.getElementById('nextBtn'),
            shuffleBtn: document.getElementById('shuffleBtn'),
            progressFill: document.getElementById('progressFill'),
            currentTimeEl: document.getElementById('currentTime'),
            totalTimeEl: document.getElementById('totalTime'),
            trackMarquee: document.getElementById('trackMarquee'),
            nextTrackInfo: document.getElementById('nextTrackInfo'),
            splash: document.getElementById('splash'),
            tapToStart: document.getElementById('tap-to-start'),
            loadingSpinner: document.getElementById('loadingSpinner'),
            audioIndicator: document.getElementById('audioIndicator'),
            likeBtn: document.getElementById('likeBtn'),
            dislikeBtn: document.getElementById('dislikeBtn'),
            genreBadge: document.getElementById('genreBadge'),
            liveInfoBalloon: document.getElementById('liveInfoBalloon'),
            liveInfoText: document.getElementById('liveInfoText'),
            balloonTimerBar: document.getElementById('balloonTimerBar'),
            notificationTop: document.getElementById('notificationTop'),
            notificationMessage: document.getElementById('notificationMessage'),
            bottomControls: document.getElementById('bottomControls'),
            visualizerBars: document.querySelectorAll('.visualizer-bar'),
            genreButton: document.getElementById('genreButton'),
            exitTvBtn: document.getElementById('exitTvBtn'),
            menuButton: document.getElementById('menuButton'),
            menuPopup: document.getElementById('menuPopup'),
            mainVideo: document.getElementById('mainVideo'),
            feedbackModal: document.getElementById('feedbackModal'),
            aiModal: document.getElementById('aiModal'),
            statsModal: document.getElementById('statsModal'),
            genresModal: document.getElementById('genresModal'),
            manualModal: document.getElementById('manualModal'),
            swipeIndicator: document.getElementById('swipeIndicator'),
            volumeToast: document.getElementById('volumeToast'),
            searchContainer: document.getElementById('searchContainer'),
            searchInput: document.getElementById('searchInput'),
            searchResults: document.getElementById('searchResults'),
            closeSearchBtn: document.getElementById('closeSearchBtn'),
            pixModal: document.getElementById('pixModal'),
            copyPixBtn: document.getElementById('copyPixBtn'),
            closePixBtn: document.getElementById('closePixBtn'),
            marqueeContent: document.getElementById('marqueeContent'),
            pixToastBelow: document.getElementById('pixToastBelow'),
            copyPixBelowBtn: document.getElementById('copyPixBelowBtn')
        };

        function shuffleArray(arr) { for (let i = arr.length - 1; i > 0; i--) { const j = Math.floor(Math.random() * (i + 1)); [arr[i], arr[j]] = [arr[j], arr[i]]; } return arr; }

        function updateMarquee(genero) {
            const likedCount = state.userPreferences.likedSongs.length;
            const generoDisplay = genero === 'LIVE' ? '🔴 AO VIVO' : (genero === 'MIX' ? 'TODOS OS GÊNEROS' : genero);
            const messages = [
                `🎵 RÁDIO PATICO MENDES IA MODO: ${generoDisplay} | 👍 ${likedCount} curtidas`,
                `⚡ IA APRENDENDO SEU GOSTO | 📻 24 HORAS`,
                `⭐ PEÇA SUA RÁDIO EXCLUSIVA PARA SUA LOJA, COM ANÚNCIOS E LINKS `,
                `💰 CONTATO: 12988461978`,
                `🎸 SERTANEJO • 🥁 FORRÓ • 🎶 SAMBA • 🎤 POP • 💔 BREGA • 🎸 MPB`
            ];
            let fullText = '';
            for (let i = 0; i < 8; i++) fullText += messages.join('   ✨   ') + '   ✨   ';
            dom.marqueeContent.innerHTML = `<span>${fullText}</span>`;
        }

        function startPixToastCycle() {
            if (window.pixToastInterval) TimerManager.clearInterval(window.pixToastInterval);
            const showToast = () => {
                dom.pixToastBelow.classList.add('show');
                TimerManager.setTimeout(() => dom.pixToastBelow.classList.remove('show'), 30000);
            };
            showToast();
            window.pixToastInterval = TimerManager.setInterval(showToast, 60000);
        }

        const AtualizadorVideo = {
            currentVideoSrc: '',
            atualizar(genero) {
                if (state.isAoVivo) { this.switchVideo(CONFIG.VIDEO_POR_GENERO.LIVE); return; }
                let videoFile = CONFIG.VIDEO_POR_GENERO[genero] || CONFIG.VIDEO_POR_GENERO.DEFAULT;
                this.switchVideo(videoFile);
            },
            switchVideo(videoFile) {
                if (this.currentVideoSrc === videoFile && dom.mainVideo.src && dom.mainVideo.src.endsWith(videoFile)) return;
                this.currentVideoSrc = videoFile;
                dom.mainVideo.pause();
                dom.mainVideo.src = videoFile;
                dom.mainVideo.load();
                dom.mainVideo.loop = true;
                dom.mainVideo.play().catch(err => console.warn(`Erro vídeo: ${err}`));
            }
        };

        const UIManager = {
            showNotification(msg, duration = 3000) {
                state.notificationQueue.push({ msg, duration });
                if (!state.notificationActive) this.processQueue();
            },
            processQueue() {
                if (state.notificationQueue.length === 0) { state.notificationActive = false; return; }
                state.notificationActive = true;
                const { msg, duration } = state.notificationQueue.shift();
                dom.notificationMessage.textContent = msg;
                dom.notificationTop.classList.add('show');
                TimerManager.setTimeout(() => { dom.notificationTop.classList.remove('show'); this.processQueue(); }, duration);
            },
            updateTrackInfo(track) {
                if (!track) return;
                dom.trackMarquee.textContent = `${track.title} - ${track.artist} [${track.genero}]`;
                dom.currentTimeEl.textContent = '0:00';
                dom.totalTimeEl.textContent = '0:00';
                dom.progressFill.style.width = '0%';
                let nextIdx = state.currentIndex + 1;
                if (nextIdx >= state.filteredPlaylist.length) nextIdx = 0;
                const nextTrack = state.filteredPlaylist[nextIdx];
                dom.nextTrackInfo.textContent = nextTrack ? `Próxima: ${nextTrack.title} - ${nextTrack.artist}` : 'Próxima: --';
            },
            showLoading() { dom.loadingSpinner.classList.add('show'); },
            hideLoading() { dom.loadingSpinner.classList.remove('show'); },
            setPlayState(playing) { dom.playBtn.innerHTML = playing ? '<i class="fas fa-pause"></i>' : '<i class="fas fa-play"></i>'; },
            startVisualizer() {
                const animate = () => {
                    if (!state.isPlaying) { dom.visualizerBars.forEach(bar => bar.style.height = '4px'); state.visualizerAnimationId = null; return; }
                    dom.visualizerBars.forEach(bar => bar.style.height = (8 + Math.random() * 32) + 'px');
                    state.visualizerAnimationId = requestAnimationFrame(animate);
                };
                if (state.visualizerAnimationId) cancelAnimationFrame(state.visualizerAnimationId);
                animate();
            },
            stopVisualizer() {
                if (state.visualizerAnimationId) { cancelAnimationFrame(state.visualizerAnimationId); state.visualizerAnimationId = null; }
                dom.visualizerBars.forEach(bar => bar.style.height = '4px');
            },
            updateGenreBadge(genero) {
                const icons = { SERTANEJO: 'fa-guitar', FORRÓ: 'fa-drum', 'FORRÓ ANTIGO': 'fa-hat-cowboy', SAMBA: 'fa-music', POP: 'fa-microphone-alt', BREGA: 'fa-heart', MPB: 'fa-guitar', VARIADAS: 'fa-random', 'MODA TOP': 'fa-star', 'AS++': 'fa-crown' };
                const icon = icons[genero] || 'fa-headphones';
                dom.genreBadge.innerHTML = `<i class="fas ${icon}"></i> ${genero === 'MIX' ? 'TODOS' : genero}`;
                dom.genreBadge.classList.remove('live');
                updateMarquee(genero);
            },
            showSwipeIndicator(text) { dom.swipeIndicator.textContent = text; dom.swipeIndicator.style.opacity = '1'; TimerManager.setTimeout(() => dom.swipeIndicator.style.opacity = '0', 1200); },
            showVolumeToast(vol) { dom.volumeToast.textContent = `🔊 Volume: ${Math.round(vol * 100)}%`; dom.volumeToast.style.opacity = '1'; TimerManager.setTimeout(() => dom.volumeToast.style.opacity = '0', 1500); }
        };

        const StorageManager = {
            loadPrefs() { const saved = localStorage.getItem('radio_patico_ai_preferences'); if (saved) try { Object.assign(state.userPreferences, JSON.parse(saved)); } catch (e) { } },
            savePrefs() { localStorage.setItem('radio_patico_ai_preferences', JSON.stringify(state.userPreferences)); },
            loadStats() { const saved = localStorage.getItem('radio_patico_stats'); if (saved) try { Object.assign(state.stats, JSON.parse(saved)); } catch (e) { } },
            saveStats() { localStorage.setItem('radio_patico_stats', JSON.stringify(state.stats)); }
        };

        const PlaylistManager = {
            shuffleArray(arr) { return shuffleArray(arr); },
            generateSmartPlaylist() {
                if (!PLAYLIST.length) return [];
                let candidates = [...PLAYLIST];
                const prefs = state.userPreferences;
                if (prefs.likedSongs.length > 0) {
                    const likedGenres = {};
                    prefs.likedSongs.forEach(id => { const m = PLAYLIST.find(mus => mus.id === id); if (m) likedGenres[m.genero] = (likedGenres[m.genero] || 0) + 1; });
                    let topGenre = Object.keys(likedGenres).reduce((a, b) => likedGenres[a] > likedGenres[b] ? a : b, null);
                    if (topGenre) candidates = candidates.filter(m => m.genero === topGenre);
                }
                candidates = candidates.filter(m => !prefs.dislikedSongs.includes(m.id));
                if (candidates.length === 0) candidates = [...PLAYLIST];
                return this.shuffleArray(candidates);
            },
            filterByGenre(genero) {
                if (state.isAoVivo) {
                    state.isAoVivo = false;
                    state.trocaAutomaticaAtiva = true;
                }
                state.trocaAutomaticaAtiva = false;
                let novaPlaylist = [];
                if (genero === 'TODOS') {
                    novaPlaylist = this.shuffleArray([...PLAYLIST]);
                    UIManager.showNotification("🎵 TOCANDO TODOS OS GÊNEROS!", 2000);
                    UIManager.updateGenreBadge("MIX");
                    state.generoAtual = "MIX";
                } else if (genero === 'AS++') {
                    novaPlaylist = PLAYLIST.filter(m => m.genero === 'AS++');
                    if (novaPlaylist.length === 0) novaPlaylist = this.shuffleArray([...PLAYLIST]);
                    else novaPlaylist = this.shuffleArray(novaPlaylist);
                    UIManager.updateGenreBadge("AS++");
                    state.generoAtual = "AS++";
                } else if (genero === 'LIVE') {
                    ativarModoAoVivo();
                    return;
                } else {
                    novaPlaylist = PLAYLIST.filter(m => m.genero === genero);
                    if (novaPlaylist.length === 0) {
                        novaPlaylist = this.shuffleArray([...PLAYLIST]);
                        UIManager.showNotification(`⚠️ Nenhuma música para ${genero}. Carregando todas.`, 2000);
                        UIManager.updateGenreBadge("MIX");
                        state.generoAtual = "MIX";
                    } else {
                        novaPlaylist = this.shuffleArray(novaPlaylist);
                        UIManager.showNotification(`🎵 ${genero} ativado - ${novaPlaylist.length} músicas!`, 2000);
                        UIManager.updateGenreBadge(genero);
                        state.generoAtual = genero;
                    }
                }
                state.filteredPlaylist = novaPlaylist;
                state.currentIndex = Math.floor(Math.random() * state.filteredPlaylist.length);
                UIManager.updateTrackInfo(state.filteredPlaylist[state.currentIndex]);
                AtualizadorVideo.atualizar(state.generoAtual === "MIX" ? "VARIADAS" : state.generoAtual);
                if (state.isPlaying) PlayerEngine.play();
            },
            proximaMusicaLive() {
                if (!state.isAoVivo) return null;
                const disponiveis = state.filteredPlaylist.filter(m => !state.historicoMusicasLive.includes(m.id));
                let prox;
                if (disponiveis.length === 0) { state.historicoMusicasLive = []; prox = state.filteredPlaylist[Math.floor(Math.random() * state.filteredPlaylist.length)]; }
                else { prox = disponiveis[Math.floor(Math.random() * disponiveis.length)]; }
                state.historicoMusicasLive.push(prox.id);
                if (state.historicoMusicasLive.length > 5) state.historicoMusicasLive.shift();
                return prox;
            }
        };

        const PlayerEngine = {
            async play() {
                if (!state.isBackgroundActive) { UIManager.showNotification('⚠️ Clique em "ATIVAR RÁDIO" primeiro!', 3000); return false; }
                if (state.filteredPlaylist.length === 0) return false;
                if (state.isLoadingTrack || state.tocandoVinheta) return false;
                state.isLoadingTrack = true;
                UIManager.showLoading();
                const track = state.filteredPlaylist[state.currentIndex];
                if (!track || !track.src) { UIManager.hideLoading(); state.isLoadingTrack = false; return false; }
                dom.musicPlayer.pause();
                dom.musicPlayer.src = track.src;
                dom.musicPlayer.load();
                if (!state.isAoVivo) UIManager.updateGenreBadge(track.genero);
                AtualizadorVideo.atualizar(state.isAoVivo ? 'LIVE' : track.genero);
                return new Promise((resolve) => {
                    const timeoutId = TimerManager.setTimeout(() => {
                        UIManager.hideLoading();
                        state.isLoadingTrack = false;
                        UIManager.showNotification(`⚠️ Tempo excedido: "${track.title}"`, 2000);
                        PlayerEngine.next();
                        resolve(false);
                    }, 8000);
                    dom.musicPlayer.oncanplaythrough = async () => {
                        TimerManager.clearTimeout(timeoutId);
                        UIManager.hideLoading();
                        state.isLoadingTrack = false;
                        try {
                            await dom.musicPlayer.play();
                            state.isPlaying = true;
                            UIManager.setPlayState(true);
                            PlayerEngine.startTimer();
                            UIManager.startVisualizer();
                            PlayerEngine.updateStats(track);
                            state.trackStartTime = Date.now();
                            dom.totalTimeEl.textContent = PlayerEngine.formatTime(dom.musicPlayer.duration);
                            dom.splash.classList.add('hidden');
                            TimerManager.setTimeout(() => dom.splash.style.display = 'none', 500);
                            dom.tapToStart.style.display = 'none';
                            resolve(true);
                        } catch (e) {
                            TimerManager.clearTimeout(timeoutId);
                            UIManager.hideLoading();
                            state.isLoadingTrack = false;
                            state.isPlaying = false;
                            UIManager.setPlayState(false);
                            resolve(false);
                        }
                    };
                    dom.musicPlayer.onerror = () => {
                        TimerManager.clearTimeout(timeoutId);
                        UIManager.hideLoading();
                        state.isLoadingTrack = false;
                        UIManager.showNotification(`⚠️ Erro ao carregar "${track.title}"`, 2000);
                        TimerManager.setTimeout(() => { state.currentIndex = (state.currentIndex + 1) % state.filteredPlaylist.length; UIManager.updateTrackInfo(state.filteredPlaylist[state.currentIndex]); PlayerEngine.play(); }, 500);
                        resolve(false);
                    };
                });
            },
            pause() { dom.musicPlayer.pause(); state.isPlaying = false; UIManager.setPlayState(false); this.stopTimer(); UIManager.stopVisualizer(); },
            togglePlayPause() { state.isPlaying ? this.pause() : this.play(); },
            async next() {
                if (state.isLoadingTrack || state.skipLock) return;
                this.stopTimer();
                if (state.isAoVivo && !state.aoVivoAcabou) {
                    const prox = PlaylistManager.proximaMusicaLive();
                    if (prox) {
                        state.filteredPlaylist.push(prox);
                        state.currentIndex = state.filteredPlaylist.length - 1;
                        UIManager.updateTrackInfo(state.filteredPlaylist[state.currentIndex]);
                        if (state.isPlaying) await this.play();
                        return;
                    }
                    let novasAoVivo = PLAYLIST.filter(m => m.tipo === "ao vivo");
                    if (novasAoVivo.length === 0) novasAoVivo = PlaylistManager.shuffleArray([...PLAYLIST]);
                    state.filteredPlaylist = PlaylistManager.shuffleArray(novasAoVivo);
                    state.currentIndex = Math.floor(Math.random() * state.filteredPlaylist.length);
                    state.historicoMusicasLive = [];
                    state.aoVivoAcabou = false;
                    UIManager.showNotification('🔄 Reiniciando AO VIVO!', 2000);
                    if (state.isPlaying) await this.play();
                    return;
                } else if (!state.isAoVivo && state.trocaAutomaticaAtiva) {
                    mudarGeneroAutomaticamente();
                    TimerManager.setTimeout(() => this.play(), 100);
                    return;
                }
                let nextIndex = state.currentIndex + 1;
                if (nextIndex >= state.filteredPlaylist.length) nextIndex = 0;
                state.currentIndex = nextIndex;
                UIManager.updateTrackInfo(state.filteredPlaylist[state.currentIndex]);
                if (state.isPlaying) await this.play();
            },
            async prev() {
                if (state.isLoadingTrack || state.skipLock) return;
                this.stopTimer();
                let prevIndex = state.currentIndex - 1;
                if (prevIndex < 0) prevIndex = state.filteredPlaylist.length - 1;
                state.currentIndex = prevIndex;
                UIManager.updateTrackInfo(state.filteredPlaylist[state.currentIndex]);
                if (state.isPlaying) await this.play();
            },
            startTimer() { this.stopTimer(); state.timerInterval = TimerManager.setInterval(() => { if (state.isPlaying && dom.musicPlayer.duration && !dom.musicPlayer.paused) { dom.progressFill.style.width = (dom.musicPlayer.currentTime / dom.musicPlayer.duration) * 100 + '%'; dom.currentTimeEl.textContent = this.formatTime(dom.musicPlayer.currentTime); } }, 200); },
            stopTimer() { if (state.timerInterval) TimerManager.clearInterval(state.timerInterval); state.timerInterval = null; },
            formatTime(sec) { if (isNaN(sec) || !isFinite(sec)) return '0:00'; const m = Math.floor(sec / 60); const s = Math.floor(sec % 60); return `${m}:${s < 10 ? '0' : ''}${s}`; },
            updateStats(track) {
                state.stats.totalPlayed++;
                if (!state.stats.genreCount[track.genero]) state.stats.genreCount[track.genero] = 0;
                state.stats.genreCount[track.genero]++;
                state.stats.currentStreak++;
                StorageManager.saveStats();
                state.contadorMusicasVinheta++;
                if (state.contadorMusicasVinheta >= CONFIG.INTERVALO_VINHETA_MUSICAS && !state.tocandoVinheta) { state.contadorMusicasVinheta = 0; AdManager.playVinheta(); }
            },
            likeCurrent() {
                if (state.skipLock) return;
                const track = state.filteredPlaylist[state.currentIndex];
                if (!track) return;
                if (!state.userPreferences.likedSongs.includes(track.id)) {
                    state.userPreferences.likedSongs.push(track.id);
                    state.userPreferences.dislikedSongs = state.userPreferences.dislikedSongs.filter(id => id !== track.id);
                    state.userPreferences.genrePreference[track.genero] = (state.userPreferences.genrePreference[track.genero] || 0) + 1;
                    StorageManager.savePrefs();
                    UIManager.showNotification(`👍 Curtiu "${track.title}"!`, 2500);
                    atualizarAIModal();
                    updateMarquee(state.generoAtual);
                } else { UIManager.showNotification(`❤️ Já curtiu "${track.title}"`, 1500); }
            },
            dislikeCurrent() {
                if (state.skipLock) return;
                const track = state.filteredPlaylist[state.currentIndex];
                if (!track) return;
                if (!state.userPreferences.dislikedSongs.includes(track.id)) {
                    state.userPreferences.dislikedSongs.push(track.id);
                    state.userPreferences.likedSongs = state.userPreferences.likedSongs.filter(id => id !== track.id);
                    StorageManager.savePrefs();
                    UIManager.showNotification(`👎 Não curtiu "${track.title}".`, 2000);
                    atualizarAIModal();
                    state.skipLock = true;
                    TimerManager.setTimeout(() => { state.skipLock = false; }, 1000);
                    this.next();
                } else { UIManager.showNotification(`👎 Já marcou "${track.title}"`, 1500); }
            }
        };

        const AdManager = {
            playVinheta() {
                if (!state.isAoVivo || state.tocandoVinheta || CONFIG.VINHETAS.length === 0) return false;
                const wasPlaying = state.isPlaying;
                if (wasPlaying) PlayerEngine.pause();
                state.tocandoVinheta = true;
                const vinhetaSrc = CONFIG.VINHETAS[Math.floor(Math.random() * CONFIG.VINHETAS.length)];
                const audioVinheta = new Audio(vinhetaSrc);
                audioVinheta.volume = CONFIG.VOLUME_PLAYER;
                audioVinheta.play().catch(e => console.warn(`Erro vinheta: ${e}`));
                audioVinheta.onended = () => { state.tocandoVinheta = false; if (wasPlaying) PlayerEngine.play(); };
                return true;
            }
        };

        let balaoTimeoutId = null;
        function mostrarBalaoAoVivo() {
            const msgs = ["DOMINGÃO DO BREGA", "BORA BEBER UMA?", "EITA SAUDADES", "RÁDIO PATICO"];
            dom.liveInfoText.textContent = msgs[Math.floor(Math.random() * msgs.length)];
            dom.liveInfoBalloon.style.display = 'block';
            dom.balloonTimerBar.style.width = '100%';
            dom.balloonTimerBar.style.transition = `width ${CONFIG.TEMPO_BALAO_LIVE}s linear`;
            dom.balloonTimerBar.style.width = '0%';
            if (balaoTimeoutId) TimerManager.clearTimeout(balaoTimeoutId);
            balaoTimeoutId = TimerManager.setTimeout(() => { dom.liveInfoBalloon.style.display = 'none'; }, CONFIG.TEMPO_BALAO_LIVE * 1000);
        }

        function mudarGeneroAutomaticamente() {
            if (!state.trocaAutomaticaAtiva || state.isAoVivo) return;
            const generos = ["SERTANEJO", "FORRÓ", "FORRÓ ANTIGO", "SAMBA", "POP", "BREGA", "MPB", "VARIADAS", "MODA TOP", "AS++"];
            let idx = generos.indexOf(state.generoAtual);
            let novo = generos[(idx + 1) % generos.length];
            let novas = PLAYLIST.filter(m => m.genero === novo);
            if (novas.length) {
                state.generoAtual = novo;
                state.filteredPlaylist = PlaylistManager.shuffleArray(novas);
                state.currentIndex = Math.floor(Math.random() * state.filteredPlaylist.length);
                UIManager.updateTrackInfo(state.filteredPlaylist[0]);
                AtualizadorVideo.atualizar(state.generoAtual);
                UIManager.showNotification(`🎵 Mudando para ${novo}!`, 3000);
                UIManager.updateGenreBadge(novo);
            }
        }

        function desativarModoAoVivo() {
            state.isAoVivo = false;
            state.trocaAutomaticaAtiva = true;
            dom.genreBadge.classList.remove('live');
            let musicasDoGenero = PLAYLIST.filter(m => m.genero === state.generoAtual);
            musicasDoGenero = PlaylistManager.shuffleArray(musicasDoGenero);
            if (musicasDoGenero.length === 0) musicasDoGenero = PlaylistManager.shuffleArray([...PLAYLIST]);
            state.filteredPlaylist = musicasDoGenero;
            state.currentIndex = Math.floor(Math.random() * state.filteredPlaylist.length);
            UIManager.updateTrackInfo(state.filteredPlaylist[0]);
            UIManager.updateGenreBadge(state.generoAtual);
            dom.liveInfoBalloon.style.display = 'none';
            AtualizadorVideo.atualizar(state.generoAtual);
            if (state.isPlaying) PlayerEngine.play();
        }

