            let hideControlsTimer;
            function showControlsPanel() { dom.bottomControls.classList.remove('hide'); TimerManager.clearTimeout(hideControlsTimer); hideControlsTimer = TimerManager.setTimeout(() => dom.bottomControls.classList.add('hide'), 3000); }
            document.addEventListener('touchstart', showControlsPanel);
