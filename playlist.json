            let touchStartX = 0, lastTap = 0;
            document.addEventListener('touchstart', e => { if (e.target.closest('#genreButton') || e.target.closest('#volumeSliderZone')) return; touchStartX = e.changedTouches[0].screenX; const now = Date.now(); if (now - lastTap < 300) { e.preventDefault(); PlayerEngine.togglePlayPause(); UIManager.showSwipeIndicator('⏯️ ' + (state.isPlaying ? 'Pausado' : 'Play')); } lastTap = now; });
            document.addEventListener('touchend', e => { if (e.target.closest('#genreButton') || e.target.closest('#volumeSliderZone')) return; const diff = e.changedTouches[0].screenX - touchStartX; if (Math.abs(diff) > 50) { if (diff > 0) { PlayerEngine.prev(); UIManager.showSwipeIndicator('⏮️ Anterior'); } else { PlayerEngine.next(); UIManager.showSwipeIndicator('⏭️ Próxima'); } } });

            const volumeZone = document.getElementById('volumeSliderZone');
            let volumeTouchStartY = 0;
            volumeZone.addEventListener('touchstart', e => { volumeTouchStartY = e.touches[0].clientY; e.preventDefault(); });
