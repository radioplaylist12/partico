            dom.tapToStart.addEventListener('click', async e => { e.stopPropagation(); UIManager.showNotification('🔊 Ativando áudio...', 2000); const ok = await ativarAudioBackground(); if (ok) { await PlayerEngine.play(); dom.tapToStart.style.display = 'none'; try { await document.documentElement.requestFullscreen(); } catch (err) { } UIManager.showNotification('✅ Rádio ao vivo!', 3000); if (state.isAoVivo) mostrarBalaoAoVivo(); } else { UIManager.showNotification('❌ Falha ao ativar áudio.', 3000); } });

            document.addEventListener('visibilitychange', () => {
                if (document.visibilityState === 'visible') {
                    if (dom.mainVideo.paused && dom.mainVideo.src) dom.mainVideo.play().catch(() => { });
                    if (state.isPlaying && dom.musicPlayer.paused && !dom.musicPlayer.ended) dom.musicPlayer.play().catch(() => { });
                }
            });
        }

        // Função que continua a inicialização após carregar a playlist
        async function iniciarPlayerAposLoad() {
            StorageManager.loadPrefs();
            StorageManager.loadStats();
            dom.musicPlayer.volume = CONFIG.VOLUME_PLAYER;
            inciarComModoAoVivo();
            dom.tapToStart.style.display = 'block';
            UIManager.startVisualizer();
            setupEventListeners();
            startPixToastCycle();
            updateMarquee('LIVE');
            console.log("✅ Rádio Patico IA - Pronto! Vídeos funcionando!");
        }

        async function init() {
            state.initCalled = true;
            await carregarPlaylist();   // carrega a playlist
            await iniciarPlayerAposLoad(); // depois inicializa o player
        }

        init();
    })();
</script>
</body>
</html>