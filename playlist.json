<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
    <title>Rádio Patico IA</title>
    <link rel="icon" type="image/png" href="falcon.png">
    <link rel="shortcut icon" href="favicon.ico">
    <link rel="apple-touch-icon" href="falcon.png">
    <link rel="manifest" href="manifest.json">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600;700&display=swap" rel="stylesheet">
    <style>
        /* ===== ESTILOS ORIGINAIS (COMPLETOS) ===== */
        :root {
            --bg-primary: #000;
            --bg-glass: rgba(0,0,0,0.7);
            --blur: 12px;
            --accent: #e63946;
            --accent-glow: rgba(230,57,70,0.4);
            --text: #fff;
            --grad-sertanejo: linear-gradient(135deg, #d4a373, #b5835a);
            --grad-forro: linear-gradient(135deg, #f4a261, #e76f51);
            --grad-forro-antigo: linear-gradient(135deg, #e9c46a, #f4a261);
            --grad-samba: linear-gradient(135deg, #2a9d8f, #264653);
            --grad-pop: linear-gradient(135deg, #0077b6, #023e8a);
            --grad-brega: linear-gradient(135deg, #e76f51, #f4a261);
            --grad-mpb: linear-gradient(135deg, #9c27b0, #6a1b9a);
            --grad-variadas: linear-gradient(135deg, #00b4d8, #0077b6);
            --grad-todos: linear-gradient(135deg, #6c757d, #495057);
            --grad-live: linear-gradient(135deg, #e63946, #9b1d1d);
            --grad-moda-top: linear-gradient(135deg, #ff006e, #8338ec);
            --grad-as-plus: linear-gradient(135deg, #3a86ff, #9c27b0);
            --border-subtle: 1px solid rgba(255,255,255,0.2);
            --btn-size: 48px;
            --play-btn-size: 52px;
        }
        * { margin:0; padding:0; box-sizing:border-box; font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif; }
        body { min-height:100vh; background:var(--bg-primary); overflow:hidden; position:fixed; width:100%; height:100%; }
        .app { width:100%; height:100vh; background:var(--bg-primary); position:relative; overflow:hidden; }
        .fullscreen-video-container { position:absolute; top:0; left:0; width:100%; height:100%; background:var(--bg-primary); z-index:1; }
        .fullscreen-video-container video { width:100%; height:100%; object-fit:cover; }
        .controls-overlay { position:absolute; top:0; left:0; width:100%; height:100%; z-index:10; display:flex; flex-direction:column; justify-content:space-between; pointer-events:none; }
        .tv-mode-active .bottom-controls,
        .tv-mode-active .feedback-buttons,
        .tv-mode-active .genre-button { transform:scale(1.2); transform-origin:bottom right; }
        .tv-mode-active .control-btn { width:52px; height:52px; font-size:1.2rem; }
        .tv-mode-active .play-btn { width:60px; height:60px; font-size:1.4rem; }
        .exit-tv-btn { position:fixed; top:20px; left:20px; background:var(--bg-glass); backdrop-filter:blur(10px); color:var(--text); border:2px solid #00d4ff; padding:10px 16px; border-radius:50px; font-size:.8rem; font-weight:bold; cursor:pointer; z-index:102; display:none; }
        .tv-mode-active .exit-tv-btn { display:block; }
        .notification-top { position:absolute; top:12px; left:12px; right:12px; text-align:center; z-index:30; pointer-events:none; transition:opacity .3s; opacity:0; }
        .notification-top.show { opacity:1; }
        .notification-top .message { display:inline-block; background:rgba(0,0,0,0.8); backdrop-filter:blur(10px); border-radius:30px; padding:6px 16px; font-size:.8rem; color:var(--text); border-left:3px solid var(--accent); }
        .live-info-balloon { position:fixed; top:80px; left:50%; transform:translateX(-50%); background:rgba(0,0,0,0.65); backdrop-filter:blur(16px); border-radius:80px; padding:8px 20px; z-index:1000; box-shadow:0 8px 32px rgba(0,0,0,0.3); cursor:pointer; display:none; animation:balloonSlideDown .4s; }
        @keyframes balloonSlideDown { from { opacity:0; transform:translateX(-50%) translateY(-30px); } to { opacity:1; transform:translateX(-50%) translateY(0); } }
        .balloon-timer { margin-top:4px; height:2px; background:rgba(255,255,255,0.3); border-radius:2px; overflow:hidden; }
        .timer-bar { width:100%; height:100%; background:var(--accent); transition:width linear; }
        .menu-button { position:absolute; top:12px; right:12px; background:rgba(0,0,0,0.6); backdrop-filter:blur(8px); color:var(--text); border:var(--border-subtle); width:40px; height:40px; border-radius:50%; display:flex; align-items:center; justify-content:center; font-size:1.2rem; cursor:pointer; z-index:31; pointer-events:auto; }
        .menu-popup { position:absolute; top:60px; right:12px; background:rgba(0,0,0,0.95); backdrop-filter:blur(10px); border-radius:20px; padding:10px; z-index:32; display:none; flex-direction:column; gap:6px; border:var(--border-subtle); pointer-events:auto; }
        .menu-popup.open { display:flex; }
        .menu-popup button { background:rgba(255,255,255,0.1); border:none; color:var(--text); padding:8px 16px; border-radius:30px; font-size:.8rem; display:flex; align-items:center; gap:8px; cursor:pointer; transition:background 0.2s; }
        .menu-popup button:hover { background:rgba(255,255,255,0.2); }
        .ai-modal,.stats-modal,.genres-modal,.manual-modal,.feedback-modal,.pix-modal { position:fixed; background:linear-gradient(135deg,#1a1a2e,#16213e); border-radius:30px; z-index:5000; display:none; }
        .ai-modal,.stats-modal,.pix-modal { top:50%; left:50%; transform:translate(-50%,-50%); padding:25px; width:350px; max-width:90vw; border:2px solid var(--accent); }
        .ai-modal.open,.stats-modal.open,.pix-modal.open { display:block; }
        .close-ai,.close-stats,.close-genres,.close-pix { width:100%; padding:10px; background:var(--accent); border:none; border-radius:20px; color:var(--text); margin-top:15px; cursor:pointer; }
        .genres-modal { bottom:0; left:0; right:0; transform:translateY(100%); transition:transform .3s; padding:20px 15px 25px; border-radius:25px 25px 0 0; }
        .genres-modal.open { transform:translateY(0); display:block; }
        .genres-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:10px; margin-bottom:15px; }
        .genre-card { border-radius:14px; padding:12px 8px; text-align:center; cursor:pointer; transition:transform .1s, background 0.2s; background:rgba(255,255,255,0.1); }
        .genre-card:active { transform:scale(0.96); }
        .genre-card i { font-size:1.6rem; display:block; margin-bottom:6px; color:var(--text); text-shadow:1px 1px 0 rgba(0,0,0,0.3); }
        .genre-card span { font-size:.7rem; font-weight:700; color:var(--text); }
        .bottom-controls { position:absolute; bottom:0; left:0; right:0; background:rgba(0,0,0,0.85); backdrop-filter:blur(12px); border-top:var(--border-subtle); padding:8px 16px; z-index:20; pointer-events:auto; transition:transform .3s ease; }
        .bottom-controls.hide { transform:translateY(100%); opacity:0; pointer-events:none; }
        .track-info { text-align:center; margin-bottom:2px; overflow:hidden; }
        .marquee-wrap { width:100%; overflow:hidden; white-space:nowrap; }
        .marquee-text { display:inline-block; animation:marquee 12s linear infinite; color:var(--text); font-size:.8rem; font-weight:500; }
        @keyframes marquee { 0% { transform:translateX(100%); } 100% { transform:translateX(-100%); } }
        .next-track { text-align:center; margin-bottom:4px; font-size:.7rem; color:#ccc; }
        .progress-area { margin-bottom:4px; }
        .progress-time { display:flex; justify-content:space-between; font-size:.65rem; color:#ccc; }
        .progress-bar { height:3px; background:rgba(255,255,255,0.3); cursor:pointer; border-radius:3px; }
        .progress-fill { height:100%; background:var(--accent); width:0%; border-radius:3px; }
        .control-buttons { display:flex; align-items:center; justify-content:center; gap:16px; }
        .control-btn { background:rgba(0,0,0,0.5); backdrop-filter:blur(4px); border:var(--border-subtle); color:var(--text); font-size:1rem; width:40px; height:40px; cursor:pointer; border-radius:50%; display:flex; align-items:center; justify-content:center; transition:transform 0.1s, background 0.2s; }
        .control-btn:active { transform:scale(0.95); background:var(--accent); }
        .play-btn { font-size:1.3rem; width:var(--play-btn-size); height:var(--play-btn-size); background:var(--accent); color:#000; border:none; box-shadow:0 0 12px var(--accent-glow); }
        .genre-marquee { position: fixed; bottom:170px; left:0; width:100%; background:rgba(0,0,0,0.85); backdrop-filter:blur(12px); padding:12px 0; z-index:28; white-space:nowrap; overflow:hidden; pointer-events:none; }
        .genre-marquee-content { display:inline-block; animation:scrollMarquee 180s linear infinite; font-size:2.2rem; font-weight:bold; color:white; letter-spacing:2px; white-space:nowrap; }
        .genre-marquee-content span { margin:0 40px; color:white; text-shadow:0 0 8px rgba(230,57,70,0.5); }
        @keyframes scrollMarquee { 0% { transform:translateX(0); } 100% { transform:translateX(-50%); } }
        .pix-toast-below { position:fixed; bottom:50px; left:50%; transform:translateX(-50%); background:linear-gradient(135deg, #00b4d8, #0077b6); backdrop-filter:blur(12px); padding:8px 16px; border-radius:50px; display:flex; align-items:center; gap:8px; z-index:1005; box-shadow:0 4px 15px rgba(0,0,0,0.3); opacity:0; transition:opacity 0.3s ease, transform 0.2s ease; pointer-events:auto; white-space:nowrap; font-weight:bold; font-size:0.8rem; cursor:pointer; }
        .pix-toast-below.show { opacity:1; }
        .pix-toast-below:active { transform:translateX(-50%) scale(0.97); }
        .pix-toast-below i { font-size:1.1rem; color:#ffd700; }
        .pix-toast-below button { background:#25D366; border:none; padding:4px 12px; border-radius:40px; font-weight:bold; cursor:pointer; font-size:0.7rem; transition:transform 0.1s, background 0.2s; }
        .pix-toast-below button:active { transform:scale(0.95); background:#1a8c4a; }
        .feedback-buttons { position:fixed; bottom:120px; left:16px; display:flex; gap:10px; z-index:27; }
        .feedback-btn { width:40px; height:40px; border-radius:50%; background:rgba(0,0,0,0.6); backdrop-filter:blur(8px); border:var(--border-subtle); cursor:pointer; display:flex; align-items:center; justify-content:center; font-size:1rem; transition:transform 0.1s, background 0.2s; }
        .feedback-btn:active { transform:scale(0.9); }
        .feedback-btn.like { color:#4ade80; }
        .feedback-btn.like:active { background:#4ade80; color:#000; }
        .feedback-btn.dislike { color:#ef4444; }
        .feedback-btn.dislike:active { background:#ef4444; color:#000; }
        .feedback-modal { bottom:80px; right:20px; width:280px; background:linear-gradient(135deg,#1a1a2e,#16213e); backdrop-filter:blur(12px); border:1px solid var(--accent); padding:15px; border-radius:20px; z-index:2001; display:none; box-shadow:0 10px 40px rgba(0,0,0,0.5); }
        .feedback-modal.open { display:block; }
        .feedback-modal h3 { color:white; text-align:center; margin-bottom:12px; font-size:1rem; }
        .rating { display:flex; gap:6px; margin:10px 0; justify-content:center; }
        .star { color:#555; font-size:1.4rem; cursor:pointer; transition:transform 0.1s, color 0.2s; }
        .star:active { transform:scale(0.9); }
        .star.active { color:#ffd700; }
        .feedback-modal textarea { width:100%; padding:10px; border-radius:12px; border:1px solid rgba(255,255,255,0.2); background:rgba(0,0,0,0.5); color:white; font-size:0.8rem; resize:vertical; margin:10px 0; }
        .feedback-modal textarea::placeholder { color:rgba(255,255,255,0.5); }
        .modal-buttons { display:flex; gap:10px; justify-content:center; margin-top:10px; }
        .modal-btn { padding:8px 16px; border-radius:25px; border:none; cursor:pointer; font-weight:bold; transition:transform 0.1s, opacity 0.2s; }
        .modal-btn:active { transform:scale(0.95); }
        .modal-btn.cancel { background:#444; color:white; }
        .modal-btn.send { background:#25D366; color:white; }
        #splash { position:fixed; top:0; left:0; width:100%; height:100%; background:var(--bg-primary); display:flex; align-items:center; justify-content:center; z-index:9999; transition:opacity .5s, visibility .5s; }
        #splash.hidden { opacity:0; visibility:hidden; pointer-events:none; }
        .splash-content { text-align:center; color:var(--text); }
        .splash-content i { font-size:4rem; color:var(--accent); margin-bottom:1rem; animation:pulse 1.5s infinite; }
        .splash-content h1 { font-family:'Poppins',sans-serif; font-size:2rem; letter-spacing:2px; background:linear-gradient(135deg,#ffffff,#e63946); -webkit-background-clip:text; background-clip:text; color:transparent; margin-bottom:5px; }
        .splash-content p { font-family:'Poppins',sans-serif; font-size:0.9rem; letter-spacing:1px; color:#ffaa66; }
        @keyframes pulse { 0% { opacity:.6; transform:scale(1); } 50% { opacity:1; transform:scale(1.1); } 100% { opacity:.6; transform:scale(1); } }
        #tap-to-start { position:fixed; bottom:20%; left:50%; transform:translateX(-50%); background:linear-gradient(135deg,#ff8c00,#ff5500); color:var(--text); padding:14px 28px; border-radius:60px; font-weight:bold; font-size:1rem; font-family:'Poppins',sans-serif; letter-spacing:1px; z-index:10000; cursor:pointer; display:none; animation:btnPulseLaranja 1.5s infinite; white-space:nowrap; box-shadow:0 4px 20px rgba(255,68,0,0.5); border:none; transition:transform 0.1s, box-shadow 0.2s; }
        #tap-to-start:active { transform:translateX(-50%) scale(0.97); box-shadow:0 2px 10px rgba(255,68,0,0.3); }
        @keyframes btnPulseLaranja { 0% { transform:translateX(-50%) scale(1); box-shadow:0 0 20px rgba(255,68,0,0.5); } 50% { transform:translateX(-50%) scale(1.03); box-shadow:0 0 40px rgba(255,68,0,0.8); } 100% { transform:translateX(-50%) scale(1); box-shadow:0 0 20px rgba(255,68,0,0.5); } }
        .genre-badge { position:absolute; top:12px; left:12px; background:rgba(0,0,0,0.7); backdrop-filter:blur(8px); padding:5px 12px; border-radius:20px; font-size:.65rem; color:var(--text); z-index:31; pointer-events:none; border-left:3px solid var(--accent); font-weight:bold; }
        .genre-badge.live { border-left:3px solid #f00; background:rgba(255,0,0,0.8); animation:pulseRed 1s infinite; }
        .audio-indicator { position:absolute; top:12px; right:60px; background:rgba(0,0,0,0.6); backdrop-filter:blur(8px); padding:3px 8px; border-radius:20px; font-size:.55rem; color:#4ade80; z-index:31; display:flex; align-items:center; gap:4px; }
        .visualizer { position:fixed; top:60px; right:16px; display:flex; gap:3px; background:rgba(0,0,0,0.5); backdrop-filter:blur(8px); padding:6px 10px; border-radius:30px; z-index:31; }
        .visualizer-bar { width:3px; height:16px; background:linear-gradient(135deg,var(--accent),#ff6b6b); border-radius:2px; transition:height .05s ease; }
        .loading-spinner { position:fixed; top:50%; left:50%; transform:translate(-50%,-50%); background:rgba(0,0,0,0.9); backdrop-filter:blur(12px); padding:12px 20px; border-radius:50px; z-index:10001; display:none; align-items:center; gap:10px; color:var(--text); font-size:.8rem; font-weight:bold; }
        .loading-spinner.show { display:flex; }
        .swipe-indicator { position:fixed; top:50%; left:50%; transform:translate(-50%,-50%); background:rgba(0,0,0,0.7); color:var(--text); padding:8px 16px; border-radius:30px; font-size:.7rem; z-index:10002; opacity:0; transition:opacity .3s; pointer-events:none; }
        .genre-button { position:fixed; bottom:120px; right:16px; width:40px; height:40px; background:radial-gradient(circle at 30% 10%,#1a1a2e,#0a0a1a); border-radius:50%; display:flex; align-items:center; justify-content:center; cursor:pointer; z-index:1000; border:2px solid rgba(0,255,255,0.6); backdrop-filter:blur(12px); animation:cyberPulse 2s infinite alternate; transition:transform 0.1s; }
        .genre-button:active { transform:scale(0.9); }
        .genre-button i { font-size:1.4rem; color:#0ff; }
        .volume-toast { position:fixed; bottom:15%; left:50%; transform:translateX(-50%); background:rgba(0,0,0,0.8); backdrop-filter:blur(8px); padding:5px 10px; border-radius:30px; font-size:.7rem; color:var(--text); z-index:1002; opacity:0; transition:opacity .2s; white-space:nowrap; }
        .volume-slider-overlay { position:fixed; right:0; top:20%; bottom:20%; width:30px; z-index:999; background:transparent; }
        .search-container { position:fixed; top:60px; left:10px; right:10px; background:rgba(0,0,0,0.95); backdrop-filter:blur(16px); border-radius:16px; padding:12px; z-index:5000; display:none; border:1px solid var(--accent); }
        .search-container.open { display:block; }
        .search-input { width:100%; padding:12px; border-radius:24px; border:1px solid var(--accent); background:#111; color:white; font-size:.9rem; outline:none; }
        .search-close { position:absolute; top:12px; right:16px; background:none; border:none; color:white; font-size:1.2rem; cursor:pointer; }
        .search-results { max-height:50vh; overflow-y:auto; margin-top:8px; }
        .search-item { padding:10px; border-bottom:1px solid rgba(255,255,255,0.1); cursor:pointer; color:white; font-size:.8rem; }
        .search-item:active { background:var(--accent); }
        @keyframes cyberPulse { 0% { box-shadow:0 0 8px rgba(0,255,255,0.4); border-color:rgba(0,255,255,0.5); } 100% { box-shadow:0 0 20px rgba(0,255,255,0.8); border-color:#0ff; } }
        @keyframes pulseRed { 0%,100% { transform:scale(1); } 50% { transform:scale(1.05); } }
        .tv-mode-active .genre-marquee { transform:scale(1.1); transform-origin:bottom; z-index:100; background:rgba(0,0,0,0.9); }
        .tv-mode-active .genre-marquee-content span { color:white !important; }
    </style>
</head>
<body>
<div id="splash"><div class="splash-content"><i class="fas fa-play-circle"></i><h1>Rádio Patico IA</h1><p>🎵 Um novo jeito de ouvir músicas</p></div></div>
<div id="tap-to-start"><i class="fas fa-play-circle"></i> 🎵 ATIVAR RÁDIO</div>
<div class="app">
    <div class="fullscreen-video-container"><video id="mainVideo" autoplay loop muted playsinline><source src="pai101.mp4" type="video/mp4"></video></div>
    <div class="live-info-balloon" id="liveInfoBalloon" style="display:none"><div class="balloon-content"><i class="fas fa-circle"></i><span id="liveInfoText">AO VIVO</span><i class="fas fa-microphone-alt"></i></div><div class="balloon-timer"><div class="timer-bar" id="balloonTimerBar"></div></div></div>
    <div id="notificationTop" class="notification-top"><div class="message" id="notificationMessage"></div></div>
    <div class="controls-overlay"><div class="bottom-controls" id="bottomControls">
        <div class="track-info"><div class="marquee-wrap"><span class="marquee-text" id="trackMarquee">🎵 Clique em ATIVAR RÁDIO</span></div></div>
        <div class="next-track"><span id="nextTrackInfo">Próxima: --</span></div>
        <div class="progress-area"><div class="progress-time"><span id="currentTime">0:00</span><span id="totalTime">0:00</span></div><div class="progress-bar" id="progressBar"><div class="progress-fill" id="progressFill"></div></div></div>
        <div class="control-buttons"><button class="control-btn" id="prevBtn"><i class="fas fa-step-backward"></i></button><button class="control-btn play-btn" id="playPauseBtn"><i class="fas fa-play"></i></button><button class="control-btn" id="shuffleBtn"><i class="fas fa-random"></i></button><button class="control-btn" id="nextBtn"><i class="fas fa-step-forward"></i></button></div>
    </div></div>
</div>

<div class="genre-marquee" id="genreMarquee">
    <div class="genre-marquee-content" id="marqueeContent"></div>
</div>

<div id="pixToastBelow" class="pix-toast-below">
    <i class="fas fa-hand-holding-heart"></i>
    <span>Pix: 12988461978</span>
    <button id="copyPixBelowBtn"><i class="fas fa-copy"></i> Copiar</button>
</div>

<div class="genre-badge" id="genreBadge"><i class="fas fa-broadcast-tower"></i> 🔴 LIVE</div>
<div class="audio-indicator" id="audioIndicator"><i class="fas fa-circle"></i> Aguardando</div>
<div class="visualizer" id="visualizer"><div class="visualizer-bar"></div><div class="visualizer-bar"></div><div class="visualizer-bar"></div><div class="visualizer-bar"></div></div>
<div class="feedback-buttons"><button class="feedback-btn like" id="likeBtn"><i class="fas fa-thumbs-up"></i></button><button class="feedback-btn dislike" id="dislikeBtn"><i class="fas fa-thumbs-down"></i></button></div>

<div class="loading-spinner" id="loadingSpinner"><i class="fas fa-circle-notch fa-spin"></i><span>Carregando música...</span></div>
<button class="genre-button" id="genreButton"><i class="fas fa-music"></i></button>
<button class="exit-tv-btn" id="exitTvBtn"><i class="fas fa-tv"></i> SAIR MODO TV</button>
<div class="menu-button" id="menuButton"><i class="fas fa-ellipsis-v"></i></div>
<div class="menu-popup" id="menuPopup">
    <button id="searchMenuBtn"><i class="fas fa-search"></i> Buscar música</button>
    <button id="tvModeMenuBtn"><i class="fas fa-tv"></i> Modo TV</button>
    <button id="fullscreenMenuBtn"><i class="fas fa-expand"></i> Tela cheia</button>
    <button id="shareMenuBtn"><i class="fas fa-share-alt"></i> Compartilhar</button>
    <button id="pixMenuBtn"><i class="fas fa-hand-holding-heart"></i> 💳 Apoiar com Pix</button>
    <button id="manualMenuBtn"><i class="fas fa-book"></i> 📘 Manual</button>
    <button id="statsMenuBtn"><i class="fas fa-chart-line"></i> 📊 Estatísticas</button>
    <button id="aiMenuBtn"><i class="fas fa-brain"></i> 🤖 IA Preferências</button>
    <button id="feedbackMenuBtn"><i class="fab fa-whatsapp"></i> Feedback</button>
</div>
<div class="ai-modal" id="aiModal"><h3><i class="fas fa-brain"></i> Inteligência Artificial</h3><div class="ai-stat"><span>🎯 Curtidas:</span><span id="aiLikedCount">0</span></div><div class="ai-stat"><span>👎 Não curtidas:</span><span id="aiDislikedCount">0</span></div><div class="ai-stat"><span>⭐ Gênero favorito:</span><span id="aiTopGenre">-</span></div><div id="aiTopSongs"></div><button class="close-ai" id="closeAiBtn">Fechar</button></div>
